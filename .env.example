# =============================================================================
# Servidor HTTP (Fastify)
# =============================================================================
NODE_ENV=development
LOG_LEVEL=info
HOST=127.0.0.1
PORT=3333
# Use 'false', 'true', ou IP/CIDR confiável separado por vírgula (ex: '127.0.0.1' ou 'loopback')
TRUST_PROXY=false

# =============================================================================
# Segurança da API (Autenticação, CORS e Rate Limit)
# =============================================================================
# Chave principal obrigatória (mínimo 32 caracteres). Gere com:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
API_KEY=substitua-por-uma-chave-secreta-de-pelo-menos-32-caracteres
# Chave anterior opcional para rotação sem downtime (deixe vazio quando não usar)
API_KEY_PREVIOUS=

# Origens permitidas no CORS separadas por vírgula.
# Vazio desabilita acesso cross-origin por browsers (recomendado para API server-to-server).
# Em production, '*' é bloqueado na inicialização.
CORS_ORIGIN=

RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# =============================================================================
# Banco de Dados (PostgreSQL)
# =============================================================================
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=seu_banco
DB_USER=seu_usuario
DB_PASSWORD=sua_senha_segura
DB_SSL=false

# =============================================================================
# Integração Followize OAuth2 (API v3)
# =============================================================================
FOLLOWIZE_CLIENT_ID=seu_client_id
FOLLOWIZE_CLIENT_SECRET=seu_client_secret
# Refresh token opcional como seed inicial (também pode ser enviado/atualizado em runtime via POST /auth/followize/refresh-token)
FOLLOWIZE_REFRESH_TOKEN=
# Arquivo local onde o access_token e refresh_token rotacionado são cacheados atomicamente
FOLLOWIZE_TOKEN_CACHE_PATH=.runtime/followize-token.json
FOLLOWIZE_TIMEOUT_MS=15000

# =============================================================================
# Agendador Cron de Sincronização (Followize -> PostgreSQL)
# =============================================================================
# Habilita a execução automática em horários específicos dentro da própria API
SYNC_CRON_ENABLED=false
# Múltiplas expressões cron separadas por ';' (ex: '0 8,12,15,18 * * 1-5; 30 9 * * 6')
SYNC_CRON_SCHEDULE=0 8,12,15,18 * * 1-5
SYNC_CRON_TIMEZONE=America/Sao_Paulo
