# =============================================================================
# Servidor HTTP (Fastify)
# =============================================================================
NODE_ENV=development
LOG_LEVEL=info
HOST=127.0.0.1
PORT=3333
# Use 'false', 'true', ou IP/CIDR confiável separado por vírgula (ex: '127.0.0.1' ou 'loopback')
TRUST_PROXY=false

# =============================================================================
# Segurança da API (Autenticação, CORS e Rate Limit)
# =============================================================================
# Chave principal obrigatória (mínimo 32 caracteres). Gere com:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
API_KEY=substitua-por-uma-chave-secreta-de-pelo-menos-32-caracteres
# Chave anterior opcional para rotação sem downtime (deixe vazio quando não usar)
API_KEY_PREVIOUS=

# Origens permitidas no CORS separadas por vírgula.
# Vazio desabilita acesso cross-origin por browsers (recomendado para API server-to-server).
# Em production, '*' é bloqueado na inicialização.
CORS_ORIGIN=

RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# =============================================================================
# Banco de Dados (PostgreSQL)
# =============================================================================
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=seu_banco
DB_USER=seu_usuario
DB_PASSWORD=sua_senha_segura
DB_SSL=false

# =============================================================================
# Integração Followize OAuth2 (API v3 — Multi-Unidade)
# =============================================================================
# Lista de unidades separadas por vírgula (padrão: MT). Cada código deve corresponder a ^[A-Z0-9_-]{2,10}$
FOLLOWIZE_UNITS=MT,PA,AP

# Credenciais OAuth2 por unidade (<U> em FOLLOWIZE_UNITS). client_id e client_secret ficam somente no .env.
# Para a unidade MT, os nomes legados (FOLLOWIZE_CLIENT_ID, FOLLOWIZE_CLIENT_SECRET, FOLLOWIZE_REFRESH_TOKEN)
# funcionam como fallback caso FOLLOWIZE_MT_* não estejam definidos.
FOLLOWIZE_MT_CLIENT_ID=seu_client_id_mt
FOLLOWIZE_MT_CLIENT_SECRET=seu_client_secret_mt
FOLLOWIZE_MT_REFRESH_TOKEN=

FOLLOWIZE_PA_CLIENT_ID=seu_client_id_pa
FOLLOWIZE_PA_CLIENT_SECRET=seu_client_secret_pa
FOLLOWIZE_PA_REFRESH_TOKEN=

FOLLOWIZE_AP_CLIENT_ID=seu_client_id_ap
FOLLOWIZE_AP_CLIENT_SECRET=seu_client_secret_ap
FOLLOWIZE_AP_REFRESH_TOKEN=

# Fallback legado opcional para MT (ignorado se FOLLOWIZE_MT_* estiver preenchido)
# FOLLOWIZE_CLIENT_ID=
# FOLLOWIZE_CLIENT_SECRET=
# FOLLOWIZE_REFRESH_TOKEN=

# Mantido apenas para importação única (cutover) do cache legado de MT caso public.tokens ainda não tenha linha para MT
FOLLOWIZE_TOKEN_CACHE_PATH=.runtime/followize-token.json
FOLLOWIZE_TIMEOUT_MS=15000

# =============================================================================
# Agendador Cron de Sincronização (Followize -> PostgreSQL)
# =============================================================================
# Habilita a execução automática em horários específicos dentro da própria API
SYNC_CRON_ENABLED=false
# Múltiplas expressões cron separadas por ';' (ex: '0 8,12,15,18 * * 1-5; 30 9 * * 6')
SYNC_CRON_SCHEDULE=0 8,12,15,18 * * 1-5
SYNC_CRON_TIMEZONE=America/Sao_Paulo
